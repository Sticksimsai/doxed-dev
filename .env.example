# Copy to .env for local dev. On Render these live in the service's Environment tab.
# Empty values (or "paste-here") count as not set — the feature just stays off.

# --- required
DATABASE_URL=postgres://postgres@localhost:5432/doxed
SESSION_SECRET=change-me-to-a-long-random-string
ID_HASH_SECRET=another-long-random-string   # duplicate-ID guard; never change once live

# --- admin
ADMIN_WALLETS=                # your Solana wallet(s), comma separated

# --- Builder API (+ AI fallback)
OPENROUTER_API_KEY=           # master key — set a monthly spending cap on it
BUILDER_MONTHLY_CREDIT_USD=100
BUILDER_RPM=60
BUILDER_MAX_KEYS=5
BUILDER_MAX_TOKENS=8192
BUILDER_MODELS=               # optional allowlist, comma separated

# --- AI summaries / repo reviews / ID risk check
ANTHROPIC_API_KEY=            # optional — uses OPENROUTER_API_KEY when empty
AI_MODEL=                     # optional — auto-picks the newest Claude Sonnet

# --- Solana
HELIUS_API_KEY=               # RPC + fee-claim history
PRIORITY_FEE_SOL=0.0005

# --- identity verification (ID scan + face scan)
KYD_PROVIDER=auto             # auto = real checks when DIDIT_API_KEY is set
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=         # webhook URL: <your site>/api/kyd/didit/webhook
DIDIT_WORKFLOW_ID=            # optional — created automatically on first boot
KYD_FRAME_ORIGIN=             # only if you put verification on your own subdomain
ALLOW_MOCK_KYD=false          # true = instant approval while no provider is set (staging only)

# --- launches
PINATA_JWT=                   # Pump.fun metadata (LetsBonk works without it)
LAUNCH_FEE_SOL=0              # e.g. 0.1 — added to the lock transaction
TREASURY_WALLET=

# --- optional sources
GITHUB_TOKEN=
X_BEARER_TOKEN=

SEED_DEMO=true                # demo tokens when the database is empty
RUN_JOBS=true
