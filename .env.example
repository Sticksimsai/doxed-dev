# --- required
DATABASE_URL=postgres://postgres@localhost:5432/doxed
SESSION_SECRET=change-me-to-a-long-random-string

# --- optional features (skipped when empty)
HELIUS_API_KEY=          # fee-claim history + faster RPC for lock checks
ANTHROPIC_API_KEY=       # AI project summaries + GitHub reviews
AI_MODEL=claude-sonnet-5-5
GITHUB_TOKEN=            # higher GitHub API limits for repo reviews
X_BEARER_TOKEN=          # read recent posts from project X accounts

# --- identity verification
KYD_PROVIDER=mock        # mock | webhook
ALLOW_MOCK_KYD=false     # true only on staging
KYD_VERIFY_URL=          # your KYC provider's hosted flow (webhook mode)
KYD_WEBHOOK_SECRET=      # HMAC secret for /api/kyd/webhook

SEED_DEMO=true           # demo tokens when the database is empty
RUN_JOBS=true
